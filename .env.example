# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL 16 + pgvector via docker compose) ─────────────────
# Compose maps the container to host port 5433 (avoids clashing with a
# locally installed PostgreSQL that may already own 5432).
DATABASE_URL=postgresql://career:career@localhost:5433/career?schema=public

# ── Auth ───────────────────────────────────────────────────────────────────
# Use long random values in production: `openssl rand -hex 48`
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0001
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-0002
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── AI providers ───────────────────────────────────────────────────────────
# MOCK_LLM=true  -> deterministic offline provider ($0, no network)
# MOCK_LLM=false -> OpenAI-compatible endpoint (set OPENAI_API_KEY; point
#                   OPENAI_BASE_URL at OpenAI, a free-tier proxy, or a local
#                   Ollama/LM Studio server)
MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MAX_OUTPUT_TOKENS=1000

# ── Rate limiting (token bucket) ───────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=900
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_SEC=60

# ── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2

# ── Agent web tools (both optional; agent degrades gracefully without them) ─
# WEB_SEARCH_PROVIDER: none | tavily | serper
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
AGENT_MAX_STEPS=6
AGENT_TOKEN_CEILING=20000

# ── Optional external MCP server the agent can call ────────────────────────
MCP_CLIENT_URL=

# ── Seed data ──────────────────────────────────────────────────────────────
# Defaults to the bundled synthetic demo data (db/seed). Point this at a
# private local folder (e.g. your own resume/tracker) to seed real data —
# that folder is git-ignored and never committed.
JOB_SKILL_DIR=
